{
  "name": "matma",
  "private": true,
  "version": "1.2.0",
  "description": "Interaktywna aplikacja do nauki matematyki (React + Vite + TS) — PWA + WebView (Android)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:materials": "node scripts/build_materials.js",
    "build": "npm run build:materials && vite build",
    "sync:www": "npm run build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "katex": "^0.18.7",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
